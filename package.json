{
  "name": "openclaw-nexus",
  "version": "1.0.2",
  "description": "OpenClaw 集成环境管理工具 - 安装、配置、终端、Agent团队协作一体化平台",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis",
    "build:portable": "electron-builder --win portable",
    "build:nsis": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.openclaw.nexus",
    "productName": "OpenClaw Nexus",
    "directories": {
      "output": "dist"
    },
    "electronDist": "./node_modules/electron/dist",
    "files": [
      "src/**/*",
      "skills-index-temp/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "src/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "src/icon.ico",
      "uninstallerIcon": "src/icon.ico",
      "installerHeaderIcon": "src/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OpenClaw Nexus",
      "artifactName": "OpenClaw-Nexus-${version}-Setup.exe",
      "perMachine": false,
      "allowElevation": true,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": 2052
    }
  },
  "author": "陈碧勇",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bihumanbu/openclaw-nexus.git"
  },
  "homepage": "https://github.com/bihumanbu/openclaw-nexus#readme",
  "bugs": {
    "url": "https://github.com/bihumanbu/openclaw-nexus/issues"
  },
  "keywords": [
    "openclaw",
    "api-key",
    "electron",
    "gui",
    "gateway",
    "provider",
    "model-management"
  ],
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5",
    "to-ico": "^1.1.5"
  }
}
